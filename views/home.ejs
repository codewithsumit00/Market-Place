<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Smart Crop Marketplace</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <!-- Navbar -->
    <header class="navbar">
        <div class="logo">
            🌾 SmartCrop
        </div>

        <nav>
            <a href="/">Home</a>
            <a href="#crops">Crops</a>
            <a href="#about">About</a>
            <a href="#contact">Contact</a>
        </nav>

        <div class="nav-buttons">
            <button class="btn btn-outline">Login</button>
            <button class="btn btn-primary">Register</button>
        </div>
    </header>


    <!-- Hero Section -->
    <section class="hero">

        <div class="hero-content">

            <p class="tagline">🌱 FARM • MARKET • CONNECT</p>

            <h1>
                Buy & Sell Crops
                <span>Smarter.</span>
            </h1>

            <p class="hero-text">
                A digital marketplace connecting farmers, buyers
                and transporters in one simple platform.
            </p>

            <div class="hero-buttons">
                <button class="btn btn-primary big-btn">
                    Browse Crops
                </button>

                <button class="btn btn-outline big-btn">
                    Sell Your Crops
                </button>
            </div>

        </div>


        <div class="hero-card">

            <div class="crop-icon">
                🌾
            </div>

            <h3>Fresh From Farmers</h3>

            <p>
                Discover agricultural products directly
                from trusted sellers.
            </p>

            <div class="stats">

                <div>
                    <strong>100+</strong>
                    <small>Crops</small>
                </div>

                <div>
                    <strong>50+</strong>
                    <small>Farmers</small>
                </div>

                <div>
                    <strong>24/7</strong>
                    <small>Marketplace</small>
                </div>

            </div>

        </div>

    </section>


    <!-- Categories -->
    <section class="section" id="crops">

        <div class="section-heading">

            <p class="section-tag">EXPLORE MARKET</p>

            <h2>Crop Categories</h2>

            <p>
                Find agricultural products according to your needs.
            </p>

        </div>


        <div class="categories">

            <div class="category-card">
                <div>🌾</div>
                <h3>Wheat</h3>
                <p>Quality wheat from local farmers.</p>
            </div>

            <div class="category-card">
                <div>🌽</div>
                <h3>Maize</h3>
                <p>Fresh maize available for buyers.</p>
            </div>

            <div class="category-card">
                <div>🍚</div>
                <h3>Rice</h3>
                <p>Different varieties of rice.</p>
            </div>

            <div class="category-card">
                <div>🥔</div>
                <h3>Vegetables</h3>
                <p>Fresh agricultural vegetables.</p>
            </div>

        </div>

    </section>


    <!-- About -->
    <section class="about section" id="about">

        <div>

            <p class="section-tag">WHY SMARTCROP?</p>

            <h2>
                One Marketplace for
                the Agriculture Ecosystem.
            </h2>

            <p>
                Smart Crop Marketplace is designed to make
                agricultural trading easier by connecting
                farmers, buyers and transporters through
                a single digital platform.
            </p>

        </div>


        <div class="features">

            <div>
                <span>👨‍🌾</span>
                <h3>For Farmers</h3>
                <p>List crops and reach more buyers.</p>
            </div>

            <div>
                <span>🛒</span>
                <h3>For Buyers</h3>
                <p>Discover crops from different sellers.</p>
            </div>

            <div>
                <span>🚚</span>
                <h3>For Transporters</h3>
                <p>Connect transportation with crop orders.</p>
            </div>

        </div>

    </section>


    <!-- Footer -->
    <footer id="contact">

        <h3>🌾 Smart Crop Marketplace</h3>

        <p>
            Connecting Agriculture with Technology.
        </p>

        <p class="copyright">
            © 2026 Smart Crop Marketplace
        </p>

    </footer>


</body>
</html>